// This config is in the KDL format: https://kdl.dev
// Input device configuration.
input {
    keyboard {
        xkb {
            // You can set rules, model, layout, variant and options.
        }

        // Enable numlock on startup, omitting this setting disables it.
        numlock
    }

    // Next sections include libinput settings.
    // Omitting settings disables them, or leaves them at their default values.
    // All commented-out settings here are examples, not defaults.
    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // Uncomment this to make the mouse warp to the center of newly focused windows.
    // warp-mouse-to-focus

    // Focus windows and outputs automatically when moving the mouse into them.
    // Setting max-scroll-amount="0%" makes it work only on windows already fully on screen.
    focus-follows-mouse max-scroll-amount="0%"
}

// You can configure outputs by their name, which you can find by running `niri msg outputs` while inside a niri instance.
/-output "eDP-1" {
    // Uncomment this line to disable this output.
    // off

    // Resolution and, optionally, refresh rate of the output.
    mode "1920x1080@120.030"

    // You can use integer or fractional scale.
    scale 1.5

    // Transform allows to rotate the output counter-clockwise.
    transform "normal"

    // Position of the output in the global coordinate space.
    position x=1280 y=0
}
include "monitor.kdl"

// Make the wallpaper stationary, rather than moving with workspaces.
layer-rule {
    match namespace="awww-daemon"
    place-within-backdrop true
}

// Disable the workspace shadows in the overview.
overview {
    workspace-shadow {
        off
    }
}

// Settings that influence how windows are positioned and sized.
layout {
    // Set gaps around windows in logical pixels.
    gaps 6

	// Set transparent workspace background color.
	background-color "transparent"

    // Set when to center a column when changing focus.
    center-focused-column "never"

    // You can customize the widths that "switch-preset-column-width" (Mod+R) toggles between.
    preset-column-widths {
        // Proportion sets the width as a fraction of the output width, taking gaps into account.
        proportion 0.5
        proportion 1.0

        // Fixed sets the width in logical pixels exactly.
        // fixed 1920
    }

    // You can change the default width of the new windows.
    default-column-width { proportion 1.0; }

    // You can change how the focus ring looks.
    focus-ring {
        // Uncomment this line to disable the focus ring.
        off

        // How many logical pixels the ring extends out from the windows.
        width 3

        // Color of the ring on the active monitor.
        active-color "#51afef"

        // Color of the ring on inactive monitors.
        inactive-color "#282c34"
    }

    // You can also add a border. It's similar to the focus ring, but always visible.
    border {
        // Uncomment this line to disable the border.
        // off

        // How many logical pixels the border extends out from the windows.
        width 3

        // Color of the border on the active monitor.
        active-color "#51afef"

        // Color of the border on inactive monitors.
        inactive-color "#282c34"

        // Color of the border around windows that request your attention.
        urgent-color "#9b0000"
    }

    // You can enable drop shadows for windows.
    shadow {
        // Uncomment the next line to enable shadows.
        // on

        // Softness controls the shadow blur radius.
        softness 30

        // Spread expands the shadow.
        spread 5

        // Offset moves the shadow relative to the window.
        offset x=0 y=5

        // You can also change the shadow color and opacity.
        color "#0007"
    }

    // Struts shrink the area occupied by windows, similarly to layer-shell panels.
    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

// Add lines to spawn processes at startup.
spawn-at-startup "waybar"
spawn-at-startup "awww-daemon"
spawn-at-startup "swayidle" "-w" "before-sleep" "swaylock -f"
spawn-at-startup "fcitx5" "-d"

// Set environment variables.
environment {
	QT_QPA_PLATFORM "wayland"
	QT_QPA_PLATFORMTHEME "qt6ct"
	QT_IM_MODULE "fcitx"
    XMODIFIERS "@im=fcitx"
    SDL_IM_MODULE "fcitx"
    GLFW_IM_MODULE "ibus"
	GTK_IM_MODULE ""
}

// Run a shell command (with variables, pipes, etc.).
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"

hotkey-overlay {
    // Uncomment this line to disable the "Important Hotkeys" pop-up at startup.
    skip-at-startup
}

// Toggle client-side decorations.
prefer-no-csd

// Set the path where screenshots are saved.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// You can also set this to null to disable saving screenshots to disk.
// screenshot-path null

// Animation settings.
animations {
    // Uncomment to turn off all animations.
    // off

    // Slow down all animations by this factor.
    // slowdown 3.0
}

// Disable the hot corners.
gestures {
    hot-corners {
        off
    }
}

// Window rules let you adjust behavior for individual windows.
// Set specific windows to open in floating mode.
window-rule {
	match app-id="galculator"
    open-floating true
}

// Set specific windows to open in floating mode and specific window size.
window-rule {
	match app-id="pavucontrol-qt"
	match title="bluetui"
	match title="nmtui"
    open-floating true
	default-column-width { proportion 0.65; }
	default-window-height { proportion 0.75; }
}

// Set specific windows to open with background blur effect.
window-rule {
    match app-id="kitty"
	opacity 0.85
    background-effect {
        blur true
    }
}

// Set keybindings.
binds {
    // Show a list of important hotkeys.
    // Mod+Shift+Slash { show-hotkey-overlay; }

    // Suggested binds for running programs.
	Mod+D		hotkey-overlay-title="Open the application launcher" { spawn "rofi" "-show" "run"; }
	Mod+F		hotkey-overlay-title="Open the file manager" { spawn "nemo"; }
	Mod+M		hotkey-overlay-title="Open the music streaming service" { spawn "spotify-launcher"; }
	Mod+P		hotkey-overlay-title="Open the screen management utility" { spawn "nwg-displays"; }
    Mod+T		hotkey-overlay-title="Open a terminal" { spawn "kitty"; }
    Mod+V		hotkey-overlay-title="Open the volume mixer" { spawn "pavucontrol-qt"; }
    Mod+W		hotkey-overlay-title="Open the web browser" { spawn "brave"; }
	Mod+Escape	hotkey-overlay-title="Lock the screen" { spawn "swaylock"; }
	Mod+Return	hotkey-overlay-title="Open a terminal" { spawn "kitty"; }

    // Use spawn-sh to run a shell command.
    Mod+B hotkey-overlay-title="Open the bluetooth manager" { spawn-sh "kitty --title=bluetui -e bluetui"; }
    Mod+N hotkey-overlay-title="Open the network manager" { spawn-sh "kitty --title=nmtui -e nmtui"; }
	
	// Map volume control keys.
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.01+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.01-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
	
	// Map media control keys.
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

	// Map screen brightness control keys.
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "--min-value=1" "-e" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "--min-value=1" "-e" "set" "5%-"; }

	// Open/close the Overview: a zoomed-out view of workspaces and windows.
	Mod+O repeat=false { toggle-overview; }

	// Close a window.
	Mod+Q repeat=false { close-window; }

	// Move column, window and workspace focus.
    Mod+H			{ focus-column-left; }
    Mod+J		    { focus-window-down; }
    Mod+K			{ focus-window-up; }
    Mod+L			{ focus-column-right; }
	Mod+Home		{ focus-column-first; }
	Mod+End			{ focus-column-last; }
	Mod+Left		{ focus-monitor-left; }
	Mod+Down		{ focus-monitor-down; }
	Mod+Up			{ focus-monitor-up; }
	Mod+Right		{ focus-monitor-right; }
	Mod+Tab			{ focus-workspace-down; }
	Mod+Shift+Tab   { focus-workspace-up; }

	// Move column and workspace focus with scroll wheel.
	Mod+WheelScrollDown			cooldown-ms=150 { focus-workspace-down; }
	Mod+WheelScrollUp			cooldown-ms=150 { focus-workspace-up; }
	Mod+Shift+WheelScrollDown   { focus-column-right; }
	Mod+Shift+WheelScrollUp     { focus-column-left; }

	// Set column and window movement.
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }
	Mod+Shift+Home  { move-column-to-first; }
	Mod+Shift+End   { move-column-to-last; }
	Mod+Shift+Left  { move-column-to-monitor-left; }
	Mod+Shift+Down  { move-column-to-monitor-down; }
	Mod+Shift+Up    { move-column-to-monitor-up; }
	Mod+Shift+Right { move-column-to-monitor-right; }

    // Move focus to workspace with number.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

	// Move column to workspace with number.
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

	// Move window to workspace with number.
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }

    // The following binds move the focused window in and out of a column.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Consume one window from the right to the bottom of the focused column.
    Mod+Comma  { consume-window-into-column; }

    // Expel the bottom window from the focused column to the right.
    Mod+Period { expel-window-from-column; }
	
	// Toggle window floating and fullscreen.
	Mod+Shift+F { toggle-window-floating; }
	Mod+Ctrl+F	{ fullscreen-window; }

	// Toggle between preset column width.
	Mod+R { switch-preset-column-width; }

	// Center column.
	Mod+C { center-column; }

    // Center all fully visible columns on screen.
    Mod+Ctrl+C { center-visible-columns; }

    // Finer width adjustments.
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Finer height adjustments when in column with other windows.
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

	// Screenshot.
    Mod+Shift+S { screenshot; }
    Print		{ screenshot-screen; }
    Alt+Print	{ screenshot-window; }

    // Bind an escape hatch to toggle the inhibitor.
    Mod+Shift+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // Sign out (Quit), Reboot, Sleep (Hibernate) and Shut down (Power off).
    Mod+Ctrl+Shift+I { quit; }
	Mod+Ctrl+Shift+R { spawn-sh "systemctl --no-wall reboot"; }
	Mod+Ctrl+Shift+S { spawn-sh "systemctl --no-wall hibernate"; }
	Mod+Ctrl+Shift+U { spawn-sh "systemctl --no-wall poweroff"; }
}
