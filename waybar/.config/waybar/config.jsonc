// -*- mode: jsonc -*-
{
    "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 6, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "niri/workspaces",
		"niri/window"
    ],
    "modules-center": [
    ],
    "modules-right": [
        "pulseaudio",
		"cpu",
		"memory",
        "network",
        "battery",
        "clock"
    ],
    "niri/workspaces": {
		"disable-click": true
    },
	"pulseaudio": {
		"format": "{icon}{volume:3}%",
		"format-muted": "{icon}   0%",
		"format-bluetooth": "<span foreground='#0082fc'>{icon}</span>{volume:3}%",
		"format-bluetooth-muted": "<span foreground='#0082fc'>{icon}</span>   0%",
		"format-icons": {
			"default": " ",
			"default-muted": ""
		}
	},
    "cpu": {
		"interval": 5,
        "format": " {usage:3}%",
        "tooltip": false
    },
    "memory": {
		"interval": 5,
        "format": " {percentage:3}%",
        "tooltip": false
    },
    "network": {
		"interval": 5,
        "format-wifi": "{icon}",
        "format-ethernet": "",
        "tooltip-format": "{ifname} via {gwaddr}",
        "format-linked": "",
        "format-disconnected": "󰤫",
		"format-disabled": "󰤮",
		"format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"]
    },
	"battery": {
		"interval": 5,
		"states": {
			"warning": 20,
			"critical": 10
		},
		"format": "{icon} {capacity:3}%",
		"format-full": "<span foreground='#00ff00'></span> {capacity:3}%",
		"format-charging": "<span foreground='#ffbf00'></span> {capacity:3}%",
		"format-plugged": "<span foreground='#ffbf00'></span> {capacity:3}%",
		"format-icons": ["", "", "", "", ""]
	},
	"clock": {
		"format": "󰃰 {:%Y-%m-%d %H:%M}",
		"tooltip-format": "<tt><small>{calendar}</small></tt>"
	}
}
